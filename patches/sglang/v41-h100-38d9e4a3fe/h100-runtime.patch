@@ -0,0 +1,75 @@
+"""Causal score masking and dual index writeback for Hopper prefill."""
+
+import triton
+import triton.language as tl
+
+
+@triton.jit
+def _mask_scores(S, L, WIDTH: tl.constexpr, STRIDE: tl.constexpr, BLOCK: tl.constexpr):
+    row = tl.program_id(0)
+    col = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    length = tl.load(L + row)
+    # Visible values stay in place; only future columns need a write.
+    tl.store(
+        S + row.to(tl.int64) * STRIDE + col,
+        -float("inf"),
+        (col < WIDTH) & (col >= length),
+    )
+
+
+def mask_prefill_scores_(scores, lengths):
+    assert scores.ndim == 2 and scores.stride(1) == 1
+    assert lengths.is_contiguous() and lengths.numel() == scores.shape[0]
+    _mask_scores[(scores.shape[0], triton.cdiv(scores.shape[1], 1024))](
+        scores, lengths, scores.shape[1], scores.stride(0), 1024
+    )
+
+
+@triton.jit
+def _write_indices(
+    I,
+    T,
+    L,
+    S,
+    R,
+    P,
+    K: tl.constexpr,
+    WIDTH: tl.constexpr,
+    SI: tl.constexpr,
+    SR: tl.constexpr,
+    SP: tl.constexpr,
+    HAS_PAGE: tl.constexpr,
+    BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    col = tl.arange(0, BLOCK)
+    idx = tl.load(I + row.to(tl.int64) * SI + col, col < K, -1)
+    token = tl.load(T + row).to(tl.int64)
+    length = tl.load(L + row)
+    valid = (idx >= 0) & (idx < length) & (idx < WIDTH)
+    tl.store(R + token * SR + col, tl.where(valid, idx, -1), col < K)
+    if HAS_PAGE:
+        slot = tl.load(S + idx.to(tl.int64), (col < K) & valid, -1)
+        tl.store(P + token * SP + col, slot, col < K)
+
+
+def write_prefill_indices(indices, tokens, lengths, slots, raw, page=None):
+    assert indices.ndim == 2 and indices.stride(1) == 1
+    assert tokens.is_contiguous() and lengths.is_contiguous() and slots.is_contiguous()
+    assert raw.stride(1) == 1 and (page is None or page.stride(1) == 1)
+    assert tokens.numel() == lengths.numel() == indices.shape[0]
+    _write_indices[(indices.shape[0],)](
+        indices,
+        tokens,
+        lengths,
+        slots,
+        raw,
+        raw if page is None else page,
+        indices.shape[1],
+        slots.numel(),
+        indices.stride(0),
+        raw.stride(0),
+        0 if page is None else page.stride(0),
+        page is not None,
+        triton.next_power_of_2(indices.shape[1]),
+    )
diff --git a/python/sglang/kernels/kda_kernels/v41_sm90/scores.py b/python/sglang/kernels/kda_kernels/v41_sm90/scores.py
