+                        tWeights0,
+                        rKScale,
+                        mOut,
+                        m_block,
+                        n_block,
+                        apply_causal_mask,
+                        seqlen.seqlen_q,
+                        seqlen.seqlen_k,
+                        max_seqlen_k,
+                        seqlen.offset_q,
+                        batch_idx,
+                        q_causal_offset,
+                        sm_scale,
+                        Int32(0),
+                        lse_max0 if const_expr(self.compute_lse) else None,
+                        lse_sum0 if const_expr(self.compute_lse) else None,
+                    )
+                    self._epilogue_store_to_gmem(
+                        1,
+                        acc1,
+                        tWeights1,
+                        rKScale,
+                        mOut,
+                        m_block,
+                        n_block,
+                        apply_causal_mask,
+                        seqlen.seqlen_q,
+                        seqlen.seqlen_k,
+                        max_seqlen_k,
+                        seqlen.offset_q,
+                        batch_idx,
+                        q_causal_offset,
+                        sm_scale,
