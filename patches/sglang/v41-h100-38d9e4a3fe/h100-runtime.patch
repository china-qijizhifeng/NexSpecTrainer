+
+            sW0_mma = cute.make_tensor(
+                sW.iterator,
+                cute.make_layout((self.q_per_stage, self.tile_n), stride=(1, 0)),
+            )
+            sW1_mma = cute.make_tensor(
+                sW.iterator + self.q_per_stage,
+                cute.make_layout((self.q_per_stage, self.tile_n), stride=(1, 0)),
