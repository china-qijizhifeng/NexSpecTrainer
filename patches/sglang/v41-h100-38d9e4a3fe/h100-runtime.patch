+++ b/test/registered/kernels/ops/attention/test_dsv41_sm90_indexer.py
@@ -0,0 +1,109 @@
+"""Differential tests for the Hopper V4.1 score contract, including buffer reuse."""
+
+import pytest
+import torch
+
+from sglang.kernels.ops.attention.dsv4.sm90_indexer import sm90_indexer_scores
+from sglang.kernels.ops.quantization.fp4_fake_quant import fake_quant_fp4
+from sglang.test.ci.ci_register import register_cuda_ci
+
+register_cuda_ci(est_time=90, stage="base-b-kernel-unit", runner_config="1-gpu-large")
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available() or torch.cuda.get_device_capability() != (9, 0),
+    reason="requires Hopper SM90",
+)
+
+
+def reference(q, k, w):
+    return (torch.einsum("bhd,nd->bhn", q, k).relu() * w[..., None]).sum(1).float()
+
+
+@pytest.mark.parametrize(
+    "rows,keys", [(1, 1), (3, 63), (17, 1025), (64, 4096), (129, 16384)]
+)
+def test_fp4_rounded_scores(rows, keys):
+    torch.manual_seed(20261105 + rows)
+    q = fake_quant_fp4(torch.randn(rows, 32, 128, device="cuda", dtype=torch.bfloat16))
+    k = fake_quant_fp4(torch.randn(keys, 128, device="cuda", dtype=torch.bfloat16))
+    # Positive weights model indexer ranking; signed weights also tested below.
+    w = torch.randn(rows, 32, device="cuda", dtype=torch.bfloat16).abs()
+    expected = reference(q, k, w)
+    actual = sm90_indexer_scores(q, k, w)
+    torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+    # The dense scorer must initialize every valid element, including last tiles.
+    assert torch.isfinite(actual).all()
+    lens = torch.arange(rows, device="cuda") % keys + 1
+    mask = torch.arange(keys, device="cuda")[None, :] >= lens[:, None]
+    expected.masked_fill_(mask, -torch.inf)
+    actual.masked_fill_(mask, -torch.inf)
+    torch.testing.assert_close(
+        actual.topk(min(512, keys)).values,
+        expected.topk(min(512, keys)).values,
+        rtol=0,
+        atol=0,
+    )
+
+
+@pytest.mark.parametrize("rows,keys", [(256, 64326), (1024, 16384)])
+def test_large_signed_reduction_selection(rows, keys):
+    torch.manual_seed(rows + keys)
+    q = fake_quant_fp4(torch.randn(rows, 32, 128, device="cuda", dtype=torch.bfloat16))
+    k = fake_quant_fp4(torch.randn(keys, 128, device="cuda", dtype=torch.bfloat16))
+    w = torch.randn(rows, 32, device="cuda", dtype=torch.bfloat16)
+    expected = reference(q, k, w)
+    actual = sm90_indexer_scores(q, k, w)
+    # FP32 reduction trees differ at cancellation/rounding boundaries. Preserve
+    # the BF16 score tolerance and require every selected score to meet the
+    # reference top-k floor; ties need not select the same column index.
+    torch.testing.assert_close(actual, expected, rtol=1 / 128, atol=1 / 1024)
+    indices = actual.topk(512, dim=-1).indices
+    floor = expected.topk(512, dim=-1).values[:, -1:]
+    assert bool((expected.gather(1, indices) >= floor).all())
+
+
+def test_signed_weights_and_graph_replay():
+    torch.manual_seed(42)
+    q = torch.randint(-2, 3, (19, 32, 128), device="cuda").bfloat16()
+    k = torch.randint(-2, 3, (1031, 128), device="cuda").bfloat16()
+    w = torch.randint(-2, 3, (19, 32), device="cuda").bfloat16() / 32
+    sm90_indexer_scores(q, k, w)
+    stream = torch.cuda.Stream()
+    stream.wait_stream(torch.cuda.current_stream())
+    with torch.cuda.stream(stream):
+        sm90_indexer_scores(q, k, w)
+    torch.cuda.current_stream().wait_stream(stream)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        actual = sm90_indexer_scores(q, k, w)
+    for scale in (0, 0.5, -1):
