+++ b/python/sglang/kernels/kda_kernels/v41_sm90/scores.py
@@ -0,0 +1,98 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Hopper dense BF16 indexer scores with torch-compatible rounding boundaries.
+
+Adapted from FlashInfer's SM90 indexer. Causal masking and top-k remain owned
+by the caller: this entry point writes every output element, including tails.
+"""
+
+import torch
+
+_compiled = {}
+
+
+def indexer_scores(
+    q: torch.Tensor,
+    k: torch.Tensor,
+    weights: torch.Tensor,
+    *,
+    output_dtype: torch.dtype = torch.float32,
+) -> torch.Tensor:
+    import cuda.bindings.driver as cuda
+    import cutlass
+    import cutlass.cute as cute
+    from cutlass.cute.runtime import from_dlpack
+
+    from .deepseek_sparse_attention.indexer_forward.indexer_fwd_sm90 import (
+        IndexerForwardSm90,
+    )
+
+    assert q.is_cuda and q.device == k.device == weights.device
+    assert torch.cuda.get_device_capability(q.device) == (9, 0)
+    assert q.dtype == k.dtype == weights.dtype == torch.bfloat16
+    assert q.ndim == 3 and q.shape[1:] == (32, 128)
+    assert k.ndim == 2 and k.shape[1] == 128
+    assert weights.shape == q.shape[:2]
+    assert output_dtype in (torch.float32, torch.bfloat16)
+    q, k, weights = q.contiguous(), k.contiguous(), weights.contiguous()
+    m, n = q.shape[0], k.shape[0]
+    # DeepSelect consumes 128-byte aligned rows, including the final row's
+    # backing storage. Both formats store the same BF16-rounded score values.
+    alignment = 128 // output_dtype.itemsize
+    stride = (n + alignment - 1) // alignment * alignment
+    output = torch.empty((1, m, stride), device=q.device, dtype=output_dtype)
+    if m == 0 or n == 0:
+        return output[0, :, :n]
+    q4, k4, w3 = q.unsqueeze(0), k[None, :, None, :], weights.unsqueeze(0)
+    stream = cuda.CUstream(torch.cuda.current_stream(q.device).cuda_stream)
+    key = (q.device.index, output_dtype)
+    if key not in _compiled:
+        tensors = [
+            from_dlpack(
+                t.detach(), assumed_align=16, enable_tvm_ffi=True
+            ).mark_layout_dynamic(leading_dim=t.ndim - 1)
+            for t in (q4, k4, w3, output)
+        ]
+        kernel = IndexerForwardSm90(
+            cutlass.BFloat16,
+            cutlass.BFloat16,
+            qhead_per_kvhead=32,
+            ratio=1,
+            dense_bf16=True,
+        )
+        _compiled[key] = cute.compile(
+            kernel,
+            tensors[0],
+            tensors[1],
+            tensors[2],
+            None,
+            None,
+            tensors[3],
+            None,
+            cutlass.Int32(1),
+            cutlass.Int32(m),
+            cutlass.Int32(n),
+            cutlass.Float32(1.0),
+            None,
+            None,
+            None,
+            stream,
+            options="--enable-tvm-ffi",
+        )
+    _compiled[key](
+        q4,
+        k4,
+        w3,
+        None,
+        None,
+        output,
+        None,
+        cutlass.Int32(1),
+        cutlass.Int32(m),
+        cutlass.Int32(n),
+        cutlass.Float32(1.0),
+        None,
+        None,
+        None,
+        stream,
+    )
+    return output[0, :, :n]
