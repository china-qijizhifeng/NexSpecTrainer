--- /dev/null
+++ b/python/sglang/srt/layers/moe/moe_runner/sm90_workspace.py
@@ -0,0 +1,102 @@
+"""Bounded scratch reuse for serial, eager SM90 MXFP4 prefill.
+
+One allocation per runtime/device, shared across compatible layers. Graphs use
+their own scratch: a graph may replay on a stream different from its capture
+stream, so sharing this eager allocation with it would introduce a data race.
+"""
+
+from __future__ import annotations
+
+import logging
+
+import torch
+
+from sglang.srt.environ import envs
+from sglang.srt.model_executor.runner_utils.capture_mode import get_is_capture_mode
+from sglang.srt.runtime_context import get_buffer, get_flags, get_platform, get_schedule
+
+logger = logging.getLogger(__name__)
+
+# Reserve the configured prefill row domain once; never change GEMM shapes.
+MAX_ROWS = 65536
+MAX_BYTES = 16 << 30
+
+
+class _Scratch:
+    def __init__(self, signature, device, max_rows, size_kwargs):
+        from flashinfer.fused_moe import cutlass_fused_moe_workspace_size
+
+        self.signature = signature
+        self.stream = torch.cuda.current_stream(device)
+        nbytes = cutlass_fused_moe_workspace_size(
+            max_num_tokens=max_rows, device=device, **size_kwargs
+        )
+        self.storage = (
+            torch.empty(nbytes, dtype=torch.uint8, device=device)
+            if nbytes <= MAX_BYTES
+            else None
+        )
+        logger.info(
+            "SM90 eager MoE workspace: requested=%d bytes, cap=%d, rows=%d, reused=%s",
+            nbytes,
+            MAX_BYTES,
+            max_rows,
+            self.storage is not None,
+        )
+
+
+def sm90_moe_workspace(x, w2, top_k, runner_config, activation_type, *, humming):
+    """Return stream-owned scratch, or keep FlashInfer's normal allocation.
+
+    No resize, no retired allocations, no per-layer cache. Other streams, shapes,
+    overlapped batches and graph warmup/capture do not borrow this arena. Outputs
+    are allocated by the caller and never alias it, so the next layer can reuse it.
+    """
+    schedule = get_schedule()
+    max_rows = min(
+        MAX_ROWS,
+        schedule.chunked_prefill_size
+        if schedule.chunked_prefill_size > 0
+        else schedule.max_prefill_tokens,
+    )
+    if not (
+        envs.SGLANG_OPT_DSV41_SM90_MOE_WORKSPACE.get()
+        and get_platform().is_sm90
+        and 1024 <= x.shape[0] <= max_rows
+        and x.dtype == torch.bfloat16
+        and not get_flags().moe.tbo_enabled
+        and not get_flags().moe.sbo_enabled
+        and not get_is_capture_mode()
+        and not torch.cuda.is_current_stream_capturing()
+    ):
+        return None
+
+    # This helper is called only by the SM90 group-scaled MXFP4 path: uint8
+    # weights pack two K values per byte, including the Humming layout.
+    size_kwargs = dict(
+        hidden_size=x.shape[1],
+        intermediate_size=w2.shape[2] * 2,
+        num_experts_total=w2.shape[0] * runner_config.moe_ep_size,
+        top_k=top_k,
+        x_dtype=x.dtype,
+        weight_dtype=w2.dtype,
+        output_dtype=torch.bfloat16,
+        activation_type=activation_type,
+        tp_size=runner_config.moe_tp_size,
+        tp_rank=runner_config.moe_tp_rank,
+        ep_size=runner_config.moe_ep_size,
+        ep_rank=runner_config.moe_ep_rank,
+        use_w4_group_scaling=True,
+        use_wfp4afp8_humming=humming,
+        use_fused_finalize=envs.SGLANG_FLASHINFER_MOE_FUSED_FINALIZE.get(),
+    )
+    signature = (max_rows, tuple(size_kwargs.items()))
+    scratch = get_buffer(
+        f"sm90_moe_eager_scratch:{x.device}",
+        lambda: _Scratch(signature, x.device, max_rows, size_kwargs),
+    )
+    if scratch.signature != signature or scratch.stream != torch.cuda.current_stream(
+        x.device
+    ):
+        return None
+    return scratch.storage
