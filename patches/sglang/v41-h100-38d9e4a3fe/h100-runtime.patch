+                apply_causal_mask = (
+                    Boolean(iter_idx < Int32(2))
+                    if const_expr(self.mask_two_rightmost_nblocks)
+                    else Boolean(iter_idx == Int32(0))
+                )
+                if const_expr(self.use_fp8_scales):
