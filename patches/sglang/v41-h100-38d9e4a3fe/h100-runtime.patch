+"""Full-prompt capture must override Compact before model/KV construction."""
+
+from types import SimpleNamespace
+
+import pytest
+
+from sglang.srt.arg_groups.deepseek_v4_hook import validate_deepseek_v41_features
+from sglang.srt.arg_groups.overrides import resolving_view
+from sglang.srt.arg_groups.serving_hook import handle_return_hidden_states_mode
+from sglang.srt.arg_groups.validation_hook import handle_aux_hidden_state_capture
+from sglang.srt.model_executor.cuda_graph_config import (
+    Backend,
+    CudaGraphConfig,
+    PhaseConfig,
+)
+from sglang.srt.runtime_context import override_platform
+from sglang.srt.server_args import ServerArgs
+from sglang.test.ci.ci_register import register_cpu_ci
+
+register_cpu_ci(est_time=10, suite="base-a-test-cpu")
+
+
+@pytest.mark.parametrize("compact", [None, True, False])
+@pytest.mark.parametrize("cp", [False, True])
+def test_full_dspark_capture_disables_compact(compact, cp):
+    args = ServerArgs(
+        model_path="local-deepseek-v41",
+        enable_return_aux_hidden_states=True,
+        speculative_algorithm="DSPARK",
+        return_aux_hidden_state_layer_ids=[37, 38, 39],
+        enable_decoder_swa_bounded_replay=compact,
+        enable_prefill_cp=cp,
+        attn_cp_size=8 if cp else 1,
+        tp_size=8,
+        chunked_prefill_size=-1,
+        dsv4_attn_backend="flashmla",
+        cuda_graph_config=CudaGraphConfig(
+            prefill=PhaseConfig(backend=Backend.DISABLED)
+        ),
+    )
+    args._model_config = SimpleNamespace(
+        hf_config=SimpleNamespace(model_type="deepseek_v41")
+    )
+    with override_platform(is_cuda=True, is_hip=False):
+        handle_return_hidden_states_mode(args)
+        handle_aux_hidden_state_capture(args)
+        validate_deepseek_v41_features(args)
+    resolved = resolving_view(args)
+    assert resolved.return_hidden_states_mode == "full"
+    assert resolved.aux_hidden_state_capture == "dspark"
+    assert resolved.speculative_algorithm is None
+    assert resolved.enable_decoder_swa_bounded_replay is False
+
+
+def test_online_dspark_keeps_explicit_compact():
+    args = ServerArgs(
+        model_path="local-deepseek-v41",
+        speculative_algorithm="DSPARK",
+        enable_decoder_swa_bounded_replay=True,
+        dsv4_attn_backend="flashmla",
+        cuda_graph_config=CudaGraphConfig(
+            prefill=PhaseConfig(backend=Backend.DISABLED)
+        ),
+    )
+    args._model_config = SimpleNamespace(
+        hf_config=SimpleNamespace(model_type="deepseek_v41")
+    )
+    with override_platform(is_cuda=True, is_hip=False):
+        validate_deepseek_v41_features(args)
+    assert resolving_view(args).enable_decoder_swa_bounded_replay is True
