+        max_seqlen_k: Int32,
+        sm_scale: Float32,
+        work_block_x: Int32,
+        work_head_idx: Int32,
+        work_batch_idx: Int32,
+    ):
+        tidx, _, _ = cute.arch.thread_idx()
