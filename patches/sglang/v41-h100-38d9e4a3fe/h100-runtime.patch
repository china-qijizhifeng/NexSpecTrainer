+"""Hopper prefill boundary fusion against the actual unfused runtime path."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.kernels.ops.layernorm.hc_combine_norm import hc_combine_norm
+from sglang.srt.environ import envs
+from sglang.srt.models.deepseek_v4_mhc import HcConfig, HcNormed, _post_fusion
+from sglang.srt.runtime_context import get_parallel
+from sglang.test.ci.ci_register import register_cuda_ci
+
+register_cuda_ci(est_time=35, stage="base-b-kernel-unit", runner_config="1-gpu-large")
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available() or torch.cuda.get_device_capability() != (9, 0),
+    reason="requires Hopper SM90",
+)
+
+
+@pytest.mark.parametrize("rows", [4096, 64326])
+def test_prefill_boundary_and_replay(rows):
+    torch.manual_seed(rows)
+    x = torch.randn(rows, 5120, device="cuda", dtype=torch.bfloat16) * 0.1
+    residual = torch.randn(rows, 4, 5120, device="cuda", dtype=x.dtype) * 0.1
+    pre, post = (torch.rand(rows, 4, device="cuda") for _ in range(2))
+    comb = torch.rand(rows, 4, 4, device="cuda")
+    comb /= comb.sum(1, keepdim=True)
+    weight = (1 + torch.rand(5120, device="cuda") * 0.1).bfloat16()
+    hc = SimpleNamespace(cfg=HcConfig(4, 20, 1e-6, 1e-6, 5120, True, False))
+    next_boundary = SimpleNamespace(
+        norm_fusable=True,
+        hc=None,
+        norm=SimpleNamespace(weight=weight, variance_epsilon=1e-6),
+    )
+
+    def run():
+        return _post_fusion(hc, x, residual, (pre, post, comb), next_boundary)
+
+    def check(actual):
+        with envs.SGLANG_OPT_DSV41_SM90_PREFILL_MHC.override(False):
+            expected = run()
+        assert expected.input is None
+        assert isinstance(actual.input, HcNormed)
+        torch.testing.assert_close(actual.residual, expected.residual, rtol=0, atol=0)
+        normalized = hc_combine_norm(expected.residual.flatten(1), pre, weight, 1e-6)
+        torch.testing.assert_close(
+            actual.input.rows, normalized, rtol=1 / 128, atol=1 / 128
+        )
+        assert actual.pre is pre
+
+    with (
+        get_parallel().override(attn_cp_size=1, attn_dp_size=1),
+        envs.SGLANG_OPT_DSV41_SM90_PREFILL_MHC.override(True),
+    ):
+        check(run())
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            actual = run()
+        x.mul_(0.5)
+        graph.replay()
+        check(actual)
+        hc.cfg = hc.cfg._replace(cp_prefill=True)
+        assert run().input is None
+
+
+if __name__ == "__main__":
+    import sys
+
+    sys.exit(pytest.main([__file__]))
