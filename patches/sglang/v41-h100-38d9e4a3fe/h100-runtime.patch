+        block_x = work_block_x
+        head_idx = work_head_idx
+        batch_idx = work_batch_idx
+
+        seqlen = SeqlenInfoQK.create(
+            batch_idx,
+            max_seqlen_q,
+            max_seqlen_k,
+            mCuSeqlensQ,
+            mCuSeqlensK,
+            None,
+            None,
+            tile_m=self.tile_m,
+            tile_n=self.tile_n,
