+    k = torch.randn(4097, 128, device="cuda", dtype=torch.bfloat16)
+    w = torch.randn(33, 32, device="cuda", dtype=torch.bfloat16)
+    expected = sm90_indexer_scores(q, k, w)
+    actual = sm90_indexer_scores(q, k, w, output_dtype=torch.bfloat16)
+    assert actual.dtype == torch.bfloat16
+    assert actual.stride(0) * actual.element_size() % 128 == 0
+    assert actual.untyped_storage().nbytes() >= 33 * actual.stride(0) * 2
+    torch.testing.assert_close(actual.float(), expected, rtol=0, atol=0)
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        actual = sm90_indexer_scores(q, k, w, output_dtype=torch.bfloat16)
+    w.mul_(-0.5)
+    graph.replay()
+    torch.testing.assert_close(
+        actual.float(), sm90_indexer_scores(q, k, w), rtol=0, atol=0
