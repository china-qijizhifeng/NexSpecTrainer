diff --git a/test/manual/kernels/attention/bench_dsv41_deepselect_prefill.py b/test/manual/kernels/attention/bench_dsv41_deepselect_prefill.py
new file mode 100644
index 0000000000..665a34a662
--- /dev/null
+++ b/test/manual/kernels/attention/bench_dsv41_deepselect_prefill.py
@@ -0,0 +1,179 @@
+"""DeepSelect prefill selection-chain experiment; no model-score evaluation."""
+
+import argparse
+import json
+import statistics
+import time
+from pathlib import Path
+
+import torch
+
+from sglang.kernels.ops.attention.deep_select import topk
+
+parser = argparse.ArgumentParser(description=__doc__)
+parser.add_argument("--output", type=Path, required=True)
+parser.add_argument("--length-pattern", choices=("ragged", "late"), default="ragged")
+args = parser.parse_args()
+args.output.parent.mkdir(parents=True, exist_ok=True)
+torch.manual_seed(20261105)
+
+
+def aligned(x, dtype):
+    alignment = 128 // torch.empty((), dtype=dtype).element_size()
+    width = (x.shape[1] + alignment - 1) // alignment * alignment
+    out = torch.empty((x.shape[0], width), device=x.device, dtype=dtype)
+    out[:, : x.shape[1]].copy_(x)
+    return out[:, : x.shape[1]]
+
+
+def timing(fn):
+    for _ in range(3):
+        fn()
+    torch.cuda.synchronize()
+    graph = torch.cuda.CUDAGraph()
+    with torch.cuda.graph(graph):
+        for _ in range(10):
+            fn()
+    samples = []
+    for _ in range(7):
+        start, end = (
+            torch.cuda.Event(enable_timing=True),
+            torch.cuda.Event(enable_timing=True),
+        )
+        start.record()
+        graph.replay()
+        end.record()
+        end.synchronize()
+        samples.append(start.elapsed_time(end) / 10)
+    return statistics.median(samples)
+
+
+def case(rows, width, distribution="normal"):
+    # Current fused scorer rounds to BF16 before writing FP32.
+    x = torch.randn((rows, width), device="cuda").bfloat16().float()
+    if distribution == "ties":
+        x.zero_()
+    lens = torch.linspace(0, width, rows, device="cuda").long()
+    if rows == 1:
+        lens.fill_(width)
+    elif rows >= 6:
+        lens[:6] = torch.tensor([0, 1, 511, 512, 513, width], device="cuda")
+    if args.length_pattern == "late":
+        lens.copy_(torch.arange(width - rows + 1, width + 1, device="cuda"))
+    columns = torch.arange(width, device="cuda")
+    slots = torch.randperm(width, device="cuda") + 100
+    tok = torch.randperm(rows, device="cuda")
+    bf16 = aligned(x, torch.bfloat16)
+    fp32 = aligned(x, torch.float32)
+    out_raw = torch.empty((rows, 512), dtype=torch.int32, device="cuda")
+    out_page = torch.empty_like(out_raw)
+
+    def write(idx):
+        reach = idx < lens[:, None]
+        out_raw[tok] = torch.where(reach, idx, -1).int()
+        out_page[tok] = torch.where(reach, slots[idx.clamp_max(width - 1)], -1).int()
+        return out_raw, out_page
+
+    def reference():
+        masked = x.masked_fill(columns[None, :] >= lens[:, None], -torch.inf)
+        idx = masked.topk(512, sorted=False).indices.sort(-1).values
+        return write(idx)
+
+    def select(scores):
+        return topk(
+            scores,
+            512,
+            end=lens.int(),
+            sorted_index=True,
+            return_value=False,
+            idx_oob_fill_value=width,
+        )[1]
+
+    def fp32_copy():
+        return write(select(aligned(x, torch.float32)))
+
+    def bf16_convert():
+        return write(select(aligned(x, torch.bfloat16)))
+
+    methods = {
+        "torch_mask_topk_sort_write": reference,
+        "deepselect_fp32_align_write": fp32_copy,
+        "deepselect_fp32_native_write": lambda: write(select(fp32)),
+        "deepselect_bf16_convert_write": bf16_convert,
+        "deepselect_bf16_native_write": lambda: write(select(bf16)),
+    }
+    reference()
+    expected = out_raw[tok].long().clone()
+
+    def validate():
+        actual = out_raw[tok].long()
+        valid = actual >= 0
+        assert torch.equal(valid.sum(-1), lens.clamp_max(512))
+        assert not ((actual >= lens[:, None]) & valid).any()
+        assert not ((actual[:, 1:] <= actual[:, :-1]) & valid[:, 1:]).any()
+        vals = x.gather(1, actual.clamp_min(0)).masked_fill(~valid, -torch.inf)
+        refs = x.gather(1, expected.clamp_min(0)).masked_fill(expected < 0, -torch.inf)
+        torch.testing.assert_close(
+            vals.sort(-1).values, refs.sort(-1).values, rtol=0, atol=0
+        )
+        assert torch.equal(
+            out_page[tok], torch.where(valid, slots[actual.clamp_min(0)], -1).int()
+        )
+
+    result = {
+        "rows": rows,
+        "width": width,
+        "distribution": distribution,
+        "chain_ms": {},
+    }
+    for name, fn in methods.items():
+        fn()
+        validate()
+        result["chain_ms"][name] = timing(fn)
+        # Validate graph replay with changed device-side lengths.
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            fn()
+        original_lens = lens.clone()
+        lens.copy_((lens + 17).clamp_max(width))
+        reference()
+        expected = out_raw[tok].long().clone()
+        graph.replay()
+        validate()
+        lens.copy_(original_lens)
+        # Recreate a reference after changing lengths, including rows initially near width.
+        reference()
+        expected = out_raw[tok].long().clone()
+    result["passed"] = True
+    return result
+
+
+results = []
+for rows, width, distribution in [
+    (256, 4096, "normal"),
+    (256, 16384, "normal"),
+    (256, 64326, "normal"),
+    (1024, 4096, "normal"),
+    (1024, 16384, "normal"),
+    (1024, 64326, "normal"),
+    (1, 64326, "normal"),
+    (6, 64326, "normal"),
+    (256, 64326, "ties"),
+]:
+    print(f"START {rows=} {width=} {distribution=}", flush=True)
+    result = case(rows, width, distribution)
+    results.append(result)
+    print(json.dumps(result), flush=True)
+    args.output.write_text(
+        json.dumps(
+            {
+                "gpu": torch.cuda.get_device_name(),
+                "torch": torch.__version__,
+                "length_pattern": args.length_pattern,
+                "scope": "selection, mask/alignment/conversion, index sort and raw/page writes; excludes scoring and model forward",
+                "cases": results,
+                "time": time.time(),
+            },
+            indent=2,
+        )
+    )
diff --git a/test/manual/kernels/attention/bench_dsv41_prefill_io.py b/test/manual/kernels/attention/bench_dsv41_prefill_io.py
new file mode 100644
index 0000000000..fdfd90b0c7
--- /dev/null
+++ b/test/manual/kernels/attention/bench_dsv41_prefill_io.py
@@ -0,0 +1,124 @@
+"""Hopper causal score/mask/select/write chain, including eager launch overhead."""
+
+import argparse
+import json
+import statistics
+import time
+from pathlib import Path
+from types import SimpleNamespace
+
+import torch
+
+from sglang.srt.environ import envs
+from sglang.srt.layers.attention.dsv4.dsv41_sparse import DeepseekV41Indexer
+from sglang.srt.layers.attention.dsv4.v41_indexer.scoring import (
+    RequestScores,
+    _score_chunks,
+    select_prefill,
+)
+
+
+def case(tokens, cp):
+    torch.manual_seed(tokens + cp)
+    positions = torch.arange(0, tokens, cp, device="cuda")
+    rows, width = positions.numel(), tokens // 2
+    q = torch.randn(rows, 32, 128, device="cuda", dtype=torch.bfloat16)
+    keys = torch.randn((width + 63) // 64 * 64, 128, device="cuda", dtype=q.dtype)
+    weights = torch.randn(rows, 32, device="cuda", dtype=q.dtype)
+    lens = (positions + 1) // 2
+    tok = torch.arange(rows, device="cuda")
+    slots = torch.randperm(width, device="cuda") + 700
+    columns = torch.arange(width, device="cuda")
+    output = SimpleNamespace(
+        out_raw_indices=torch.empty(rows, 512, device="cuda", dtype=torch.int32),
+        out_page_indices=torch.empty(rows, 512, device="cuda", dtype=torch.int32),
+    )
+    indexer = SimpleNamespace()
+    indexer.uses_sm90_scores = lambda q, k, w: DeepseekV41Indexer.uses_sm90_scores(
+        indexer, q, k, w
+    )
+    indexer.scores = lambda q, k, w, **kw: DeepseekV41Indexer.scores(
+        indexer, q, k, w, **kw
+    )
+    results = {"tokens": tokens, "local_rows": rows, "cp": cp}
+    reference = None
+    for fused in [False, True]:
+
+        def run():
+            request = RequestScores(
+                width,
+                512,
+                columns,
+                tok,
+                lens,
+                slots,
+                lens.tolist() if fused else None,
+            )
+            for chunk in _score_chunks(
+                indexer=indexer, q=q, weights=weights, index_k=keys, request=request
+            ):
+                select_prefill(output, request, chunk)
+
+        with (
+            envs.SGLANG_OPT_DSV41_SM90_INDEXER.override(True),
+            envs.SGLANG_OPT_DSV41_SM90_DEEPSELECT_PREFILL.override(True),
+            envs.SGLANG_OPT_DSV41_SM90_PREFILL_IO.override(fused),
+        ):
+            for _ in range(3):
+                run()
+            torch.cuda.synchronize()
+            if reference is None:
+                reference = output.out_raw_indices.clone()
+            else:
+                # Ties can select different equal-score indices after K trimming.
+                # Compare the selected scores row-wise rather than their identity.
+                a = output.out_raw_indices.long()
+                b = reference.long()
+                valid = a >= 0
+                assert torch.equal(valid.sum(-1), lens.clamp_max(512))
+                assert not ((a >= lens[:, None]) & valid).any()
+                assert torch.equal(
+                    output.out_page_indices,
+                    torch.where(valid, slots[a.clamp_min(0)], -1).int(),
+                )
+                for start in range(0, rows, 128):
+                    scores = indexer.scores(
+                        q[start : start + 128], keys, weights[start : start + 128]
+                    )
+                    aa, bb = a[start : start + 128], b[start : start + 128]
+                    av = scores.gather(1, aa.clamp_min(0)).masked_fill(
+                        aa < 0, -torch.inf
+                    )
+                    bv = scores.gather(1, bb.clamp_min(0)).masked_fill(
+                        bb < 0, -torch.inf
+                    )
+                    torch.testing.assert_close(
+                        av.sort(-1).values, bv.sort(-1).values, rtol=0, atol=0
+                    )
+            samples = []
+            for _ in range(7):
+                torch.cuda.synchronize()
+                start = time.perf_counter()
+                run()
+                torch.cuda.synchronize()
+                samples.append((time.perf_counter() - start) * 1000)
+            results["io_ms" if fused else "baseline_ms"] = statistics.median(samples)
+    results["passed"] = True
+    return results
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--output", type=Path, required=True)
+    args = parser.parse_args()
+    assert torch.cuda.get_device_capability() == (9, 0)
+    results = []
+    for tokens, cp in [(16384, 1), (64326, 1), (64326, 8)]:
+        result = case(tokens, cp)
+        print(json.dumps(result), flush=True)
+        results.append(result)
+        args.output.write_text(json.dumps(results, indent=2))
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/manual/kernels/communication/bench_dsv41_sm90_mhc.py b/test/manual/kernels/communication/bench_dsv41_sm90_mhc.py
new file mode 100644
index 0000000000..ac41fd6af8
--- /dev/null
+++ b/test/manual/kernels/communication/bench_dsv41_sm90_mhc.py
@@ -0,0 +1,130 @@
+"""TP8 Hopper attention all-reduce + mHC boundary, eager checks and graph timing.
+
+Run on eight H100 GPUs with:
+    torchrun --standalone --nproc_per_node=8 <this file>
+
+The baseline here is CustomAllReduceV2 + post + combine/norm. Serving may use
+FlashInfer all-reduce instead; model E2E is required to establish that speedup.
+"""
+
+import atexit
+import json
+import os
+from pathlib import Path
+
+import torch
+import torch.distributed as dist
+
+import sglang.srt.distributed.parallel_state as ps
+from sglang.kernels.ops.communication import all_reduce_fusion
+from sglang.kernels.ops.communication.all_reduce_mhc import (
+    all_reduce_mhc_post_combine_norm,
+)
+from sglang.kernels.ops.layernorm.hc_combine_norm import hc_combine_norm
+from sglang.kernels.ops.layernorm.mhc_post_split_h import mhc_post_split_h
+from sglang.srt.distributed.comm_cleanup import register_comm_cleanup
+from sglang.srt.distributed.device_communicators.custom_all_reduce_v2 import (
+    CustomAllReduceV2,
+)
+from sglang.srt.runtime_context import get_parallel
+
+
+def main():
+    rank = int(os.environ["LOCAL_RANK"])
+    world = int(os.environ["WORLD_SIZE"])
+    assert world == 8
+    torch.cuda.set_device(rank)
+    assert torch.cuda.get_device_capability() == (9, 0)
+    dist.init_process_group(backend="gloo")
+    ps._WORLD = coord = ps.init_world_group(
+        ranks=list(range(world)), local_rank=rank, backend="nccl"
+    )
+    get_parallel().override_permanently(world_group=coord)
+    atexit.register(dist.destroy_process_group)
+    comm = CustomAllReduceV2(
+        coord.cpu_group,
+        torch.device(f"cuda:{rank}"),
+        max_pull_size=4 << 20,
+        max_push_size=4 << 20,
+        max_push_blocks=512,
+    )
+    assert not comm.disabled
+    all_reduce_fusion.register_comm(comm.obj)
+    register_comm_cleanup(comm)
+    results = []
+    for m in [1, 2, 6, 16, 32, 64]:
+        torch.manual_seed(m)
+        residual = torch.randn(m, 4, 5120, device="cuda", dtype=torch.bfloat16) * 0.1
+        post = torch.rand(m, 4, device="cuda")
+        comb = torch.rand(m, 4, 4, device="cuda")
+        comb /= comb.sum(1, keepdim=True)
+        pre = torch.rand(m, 4, device="cuda")
+        gamma = torch.ones(5120, device="cuda", dtype=torch.bfloat16)
+        torch.manual_seed(1000 + rank)
+        partial = torch.randn(m, 5120, device="cuda", dtype=torch.bfloat16) * 0.125
+
+        def fused():
+            return all_reduce_mhc_post_combine_norm(
+                partial, residual, post, comb, pre, gamma, 1e-6, world_size=world
+            )
+
+        def baseline():
+            reduced = comm.custom_all_reduce(partial)
+            updated = mhc_post_split_h(reduced, residual, post, comb)
+            normed = hc_combine_norm(updated.flatten(1), pre, gamma, 1e-6)
+            return reduced, updated, normed
+
+        def check(actual):
+            reduced = partial.float().clone()
+            dist.all_reduce(reduced, group=coord.device_group)
+            reduced = reduced.bfloat16()
+            updated = mhc_post_split_h(reduced, residual, post, comb)
+            normed = hc_combine_norm(updated.flatten(1), pre, gamma, 1e-6)
+            for a, b in zip(actual, (reduced, updated, normed)):
+                torch.testing.assert_close(a, b, atol=0.02, rtol=0.02)
+                others = [torch.empty_like(a) for _ in range(world)]
+                dist.all_gather(others, a, group=coord.device_group)
+                assert all(torch.equal(a, t) for t in others), "rank mismatch"
+
+        check(fused())
+        for _ in range(3):
+            baseline()
+            fused()
+        graphs = {}
+        for name, fn in [("baseline", baseline), ("fused", fused)]:
+            graph = torch.cuda.CUDAGraph()
+            dist.barrier()
+            torch.cuda.synchronize()
+            with comm.capture():
+                with torch.cuda.graph(graph):
+                    for _ in range(20):
+                        out = fn()
+            graphs[name] = (graph, out)
+        partial.mul_(0.5)
+        graphs["fused"][0].replay()
+        check(graphs["fused"][1])
+        row = {"rows": m}
+        for name, (graph, out) in graphs.items():
+            dist.barrier()
+            torch.cuda.synchronize()
+            a, b = (
+                torch.cuda.Event(enable_timing=True),
+                torch.cuda.Event(enable_timing=True),
+            )
+            a.record()
+            for _ in range(40):
+                graph.replay()
+            b.record()
+            b.synchronize()
+            elapsed = torch.tensor([a.elapsed_time(b) / 800], device="cuda")
+            dist.all_reduce(elapsed, op=dist.ReduceOp.MAX, group=coord.device_group)
+            row[name + "_ms"] = elapsed.item()
+        results.append(row)
+        if rank == 0:
+            print(json.dumps(row), flush=True)
+            Path("collective-bench.json").write_text(json.dumps(results, indent=2))
+    dist.barrier()
+
+
+if __name__ == "__main__":
+    main()
diff --git a/test/registered/kernels/ops/attention/test_dsv41_sm90_indexer.py b/test/registered/kernels/ops/attention/test_dsv41_sm90_indexer.py
