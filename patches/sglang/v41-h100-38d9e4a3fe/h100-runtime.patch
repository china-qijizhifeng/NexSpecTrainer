@@ -0,0 +1,182 @@
+"""Actual Hopper selection/writeback contracts, including graph length changes."""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.kernels.ops.attention.dsv4.sm90_prefill_io import mask_prefill_scores_
+from sglang.srt.environ import envs
+from sglang.srt.layers.attention.dsv4.dsv41_sparse import DeepseekV41Indexer
+from sglang.srt.layers.attention.dsv4.v41_indexer.scoring import (
+    ChunkScores,
+    RequestScores,
+    _score_chunks,
+    select_prefill,
+)
+from sglang.test.ci.ci_register import register_cuda_ci
+
+register_cuda_ci(est_time=60, stage="base-b-kernel-unit", runner_config="1-gpu-large")
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available() or torch.cuda.get_device_capability() != (9, 0),
+    reason="requires Hopper SM90",
+)
+
+
+@pytest.mark.parametrize("width", [511, 1025, 64326])
+@pytest.mark.parametrize("page_output", [False, True])
+@pytest.mark.parametrize("fused_io", [False, True])
+def test_selection_writeback_and_replay(width, page_output, fused_io):
+    torch.manual_seed(width)
+    rows, k = 6, min(512, width)
+    stride = (width + 63) // 64 * 64
+    scores = torch.randn(rows, stride, device="cuda", dtype=torch.bfloat16)[:, :width]
+    # Include many ties, causal tails, and shorter-than-k rows.
+    scores[3].zero_()
+    lens = torch.tensor([0, 1, 510, 511, 512, width], device="cuda").clamp_max(width)
+    tok = torch.tensor([7, 0, 3, 2, 8, 5], device="cuda")
+    slots = torch.randperm(width, device="cuda") + 500
+    request = RequestScores(
+        width, k, torch.arange(width, device="cuda"), tok, lens, slots
+    )
+    chunk = ChunkScores(slice(0, rows), tok, lens, scores)
+    raw = torch.full((10, 512), -77, dtype=torch.int32, device="cuda")
+    page = torch.full_like(raw, -77) if page_output else None
+    inputs = SimpleNamespace(out_raw_indices=raw, out_page_indices=page)
+
+    def run():
+        # Caller contract: future positions are masked, preserving row layout.
+        owner = torch.empty((rows, stride), device="cuda", dtype=scores.dtype)
+        owner[:, :width].copy_(scores)
+        masked = owner[:, :width]
+        if fused_io:
+            mask_prefill_scores_(masked, lens)
+        else:
+            masked.masked_fill_(request.columns[None, :] >= lens[:, None], -torch.inf)
+        select_prefill(inputs, request, ChunkScores(chunk.rows, tok, lens, masked))
+
+    def check():
+        actual = raw[tok, :k].long()
+        valid = actual >= 0
+        assert torch.equal(valid.sum(-1), lens.clamp_max(k))
+        assert not ((actual >= lens[:, None]) & valid).any()
+        assert not ((actual[:, 1:] <= actual[:, :-1]) & valid[:, 1:]).any()
+        got = scores.gather(1, actual.clamp_min(0)).masked_fill(~valid, -torch.inf)
+        ref = scores.masked_fill(request.columns[None, :] >= lens[:, None], -torch.inf)
+        torch.testing.assert_close(
+            got.sort(-1).values, ref.topk(k).values.sort(-1).values, rtol=0, atol=0
+        )
+        if page is not None:
+            assert torch.equal(
+                page[tok, :k], torch.where(valid, slots[actual.clamp_min(0)], -1).int()
+            )
+        assert (raw[[1, 4, 6, 9]] == -77).all()
+        assert (raw[:, k:] == -77).all()
+
+    with (
+        envs.SGLANG_OPT_DSV41_SM90_DEEPSELECT_PREFILL.override(True),
+        envs.SGLANG_OPT_DSV41_SM90_PREFILL_IO.override(fused_io),
+    ):
+        run()
+        check()
+        graph = torch.cuda.CUDAGraph()
+        with torch.cuda.graph(graph):
+            run()
+        lens.copy_(torch.tensor([width, 0, 1, 31, 510, width - 1], device="cuda"))
+        graph.replay()
+        check()
+
+
+@pytest.mark.parametrize("dtype", [torch.bfloat16, torch.float32])
+def test_score_chunks_preserve_alignment(dtype):
+    torch.manual_seed(9)
+    rows, width = 33, 1025
+    q = torch.randn(rows, 32, 128, device="cuda", dtype=dtype)
+    keys = torch.randn(1088, 128, device="cuda", dtype=dtype)
+    weights = torch.randn(rows, 32, device="cuda", dtype=dtype)
+    lens = torch.linspace(0, width, rows, device="cuda").long()
+    tok = torch.arange(rows, device="cuda")
+    request = RequestScores(
+        width,
+        512,
+        torch.arange(width, device="cuda"),
+        tok,
+        lens,
+        torch.arange(width, device="cuda"),
+    )
+    indexer = SimpleNamespace()
+    indexer.uses_sm90_scores = lambda q, k, w: DeepseekV41Indexer.uses_sm90_scores(
+        indexer, q, k, w
+    )
+    indexer.scores = lambda q, k, w, **kw: DeepseekV41Indexer.scores(
+        indexer, q, k, w, **kw
+    )
+    with (
+        envs.SGLANG_OPT_DSV41_SM90_INDEXER.override(True),
+        envs.SGLANG_OPT_DSV41_SM90_DEEPSELECT_PREFILL.override(True),
+    ):
+        chunks = list(
+            _score_chunks(
+                indexer=indexer, q=q, weights=weights, index_k=keys, request=request
+            )
+        )
+    assert len(chunks) == 1
+    scores = chunks[0].scores
+    assert scores.dtype == dtype
+    if dtype == torch.bfloat16:
+        assert scores.stride(0) * 2 % 128 == 0
+    else:
+        expected = indexer.scores(q, keys, weights)[:, :width]
+        expected.masked_fill_(request.columns[None, :] >= lens[:, None], -torch.inf)
+        torch.testing.assert_close(scores, expected, rtol=0, atol=0)
+    assert torch.isneginf(scores[request.columns[None, :] >= lens[:, None]]).all()
+
+
+def test_causal_tile_trimming_matches_full_scores():
+    torch.manual_seed(59)
+    rows, width = 2051, 4097
+    q = torch.randn(rows, 32, 128, device="cuda", dtype=torch.bfloat16)
+    keys = torch.randn(4160, 128, device="cuda", dtype=torch.bfloat16)
+    weights = torch.randn(rows, 32, device="cuda", dtype=torch.bfloat16)
+    lens = torch.linspace(0, width, rows, device="cuda").long()
+    tok = torch.arange(rows, device="cuda")
+    columns = torch.arange(width, device="cuda")
+    base = RequestScores(width, 512, columns, tok, lens, columns)
+    trimmed = RequestScores(width, 512, columns, tok, lens, columns, lens.tolist())
+    indexer = SimpleNamespace()
+    indexer.uses_sm90_scores = lambda q, k, w: DeepseekV41Indexer.uses_sm90_scores(
+        indexer, q, k, w
+    )
+    indexer.scores = lambda q, k, w, **kw: DeepseekV41Indexer.scores(
+        indexer, q, k, w, **kw
+    )
+    with (
+        envs.SGLANG_OPT_DSV41_SM90_INDEXER.override(True),
+        envs.SGLANG_OPT_DSV41_SM90_DEEPSELECT_PREFILL.override(True),
+    ):
+        with envs.SGLANG_OPT_DSV41_SM90_PREFILL_IO.override(False):
+            full = list(
+                _score_chunks(
+                    indexer=indexer, q=q, weights=weights, index_k=keys, request=base
+                )
+            )
+        with envs.SGLANG_OPT_DSV41_SM90_PREFILL_IO.override(True):
+            short = list(
+                _score_chunks(
+                    indexer=indexer, q=q, weights=weights, index_k=keys, request=trimmed
+                )
+            )
+    assert len(full) == len(short) == 3
+    assert short[0].scores.shape[1] < width
+    for a, b in zip(full, short):
+        n = b.scores.shape[1]
+        torch.testing.assert_close(a.scores[:, :n], b.scores, rtol=0, atol=0)
+        assert torch.isneginf(a.scores[:, n:]).all()
+        assert torch.isneginf(b.scores[columns[None, :n] >= b.lens[:, None]]).all()
+
+
+if __name__ == "__main__":
+    import sys
+
+    sys.exit(pytest.main([__file__]))
