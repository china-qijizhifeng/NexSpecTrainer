+"""Real SM90 MoE differential checks for eager scratch reuse and graph isolation."""
+
+from contextlib import nullcontext
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from sglang.test.ci.ci_register import register_cuda_ci
+
+register_cuda_ci(est_time=90, stage="base-b-kernel-unit", runner_config="1-gpu-large")
+
+pytestmark = pytest.mark.skipif(
+    not torch.cuda.is_available() or torch.cuda.get_device_capability() != (9, 0),
+    reason="SM90 CUDA required",
+)
+
+
+@pytest.mark.parametrize("humming", [False, True])
+@pytest.mark.parametrize("ep_rank", [None, 0, 3, 7])
+@pytest.mark.parametrize("prefill_chunk", [16384, -1])
+def test_workspace_reuse_stream_and_graph_isolation(
+    humming, ep_rank, prefill_chunk, monkeypatch
+):
+    from flashinfer.fused_moe import (
+        interleave_moe_scales_for_sm90_mixed_gemm as interleave_scales,
+    )
+    from flashinfer.fused_moe import (
+        interleave_moe_weights_for_sm90_mixed_gemm as interleave_weights,
+    )
+    from flashinfer.fused_moe import (
+        preprocess_moe_weights_for_sm90_mixed_gemm_humming as pack_humming,
+    )
+
+    from sglang.srt.environ import envs
+    from sglang.srt.layers.moe.moe_runner import flashinfer_cutlass as runner
+    from sglang.srt.layers.moe.moe_runner import sm90_workspace
+    from sglang.srt.layers.moe.moe_runner.base import MoeRunnerConfig
+    from sglang.srt.layers.moe.token_dispatcher.standard import StandardDispatchOutput
+    from sglang.srt.layers.moe.topk import StandardTopKOutput
+    from sglang.srt.runtime_context import get_context, get_parallel
+
+    torch.manual_seed(42)
+    experts, hidden, inter, tokens, topk = 8, 512, 256, 2051, 2
+    ep_size = 1 if ep_rank is None else 8
+    weights, scales, residuals = [], [], []
+    for n, k in [(2 * inter, hidden), (hidden, inter)]:
+        w = torch.randint(
+            0, 256, (experts, n, k // 2), device="cuda", dtype=torch.uint8
+        )
+        s = torch.full((experts, n, k // 32), 119, device="cuda", dtype=torch.uint8)
+        if humming:
+            w, s, residual = pack_humming(w, s)
+            residuals.append(residual * 64.0)
+        else:
+            w = interleave_weights(w, "fp4")
+            s = interleave_scales(s, group_size=32)
+        weights.append(w)
+        scales.append(s)
+    info = runner.FlashInferCutlassMxfp4MoeQuantInfo(
+        w13_weight=weights[0],
+        w2_weight=weights[1],
+        w13_weight_scale=scales[0],
+        w2_weight_scale=scales[1],
+        w13_humming_residual_scale=residuals[0] if humming else None,
+        w2_humming_residual_scale=residuals[1] if humming else None,
+        humming_fc2_act_scale=torch.ones((), device="cuda") if humming else None,
+    )
+    config = MoeRunnerConfig(
+        layer=SimpleNamespace(
+            moe_tp_size=1,
+            moe_tp_rank=0,
+            moe_ep_size=ep_size,
+            moe_ep_rank=ep_rank or 0,
+        )
+    )
+    x = torch.randn(tokens, hidden, device="cuda", dtype=torch.bfloat16) * 0.1
+    ids = (
+        torch.randn(tokens, experts * ep_size, device="cuda")
+        .topk(topk, dim=1)
+        .indices.int()
+    )
+    routing = torch.rand(tokens, topk, device="cuda")
+    routing /= routing.sum(1, keepdim=True)
+    dispatch = StandardDispatchOutput(x, None, StandardTopKOutput(routing, ids, None))
+    monkeypatch.setattr(runner, "use_symmetric_memory", lambda *a, **k: nullcontext())
+    monkeypatch.setattr(runner, "is_allocation_symmetric", lambda: False)
+    monkeypatch.setattr(runner, "_cutlass_moe_tune_max_num_tokens", lambda n: 8192)
+    # Fresh context-owned arena for each precision, without changing other buffers.
+    key = f"sm90_moe_eager_scratch:{x.device}"
+    saved = get_context().resources.buffers.pop(key, None)
+
+    def run(enabled):
+        with envs.SGLANG_OPT_DSV41_SM90_MOE_WORKSPACE.override(enabled):
+            return runner._fused_experts_flashinfer_mxfp4_cutlass(
+                dispatch, info, config
+            ).hidden_states
+
+    try:
+        with (
+            get_context().override_server_args(
+                chunked_prefill_size=prefill_chunk, max_prefill_tokens=65536
+            ),
+            get_parallel().override(tp_group=None),
+        ):
+            expected = run(False)
+            actual = run(True)
+            torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+            scratch = get_context().resources.buffers[key]
+            assert scratch.storage is not None
+            assert scratch.storage.numel() <= sm90_workspace.MAX_BYTES
+            pointer = scratch.storage.data_ptr()
+            # A second layer/call must consume changed inputs, without changing
+            # the first call's returned output or allocating a larger arena.
+            x.mul_(0.7)
+            routing.copy_(routing.flip(1))
+            second = run(True)
+            torch.testing.assert_close(second, run(False), rtol=0, atol=0)
+            torch.testing.assert_close(actual, expected, rtol=0, atol=0)
+            assert get_context().resources.buffers[key].storage.data_ptr() == pointer
+            other = torch.cuda.Stream()
+            other.wait_stream(torch.cuda.current_stream())
+            with torch.cuda.stream(other):
+                third = run(True)
+            torch.cuda.current_stream().wait_stream(other)
+            torch.testing.assert_close(third, second, rtol=0, atol=0)
+            # Capture must own its scratch even if the eager arena is overwritten
+            # between replays; compare a changed-input replay with the real kernel.
+            graph = torch.cuda.CUDAGraph()
+            with torch.cuda.graph(graph):
+                captured = run(True)
+            scratch.storage.fill_(173)
+            x.mul_(0.8)
+            expected = run(False)
+            graph.replay()
+            torch.testing.assert_close(captured, expected, rtol=0, atol=0)
+            assert get_context().resources.buffers[key].storage.data_ptr() == pointer
+    finally:
+        torch.cuda.synchronize()
+        get_context().resources.buffers.pop(key, None)
+        if saved is not None:
+            get_context().resources.buffers[key] = saved
