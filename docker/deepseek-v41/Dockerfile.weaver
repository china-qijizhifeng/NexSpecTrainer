# Build only the missing native wheels against Weaver's original Torch ABI.
ARG BASE_IMAGE=harbor.local.clusters/bp/weaver-trainer-megatron-bridge:v1.14.92@sha256:cba116d15f4be378c467a5d15157b69e3307e21c3c67342a06481f8f4a1187df
FROM ${BASE_IMAGE} AS builder
USER root
WORKDIR /tmp
ENV PIP_CONFIG_FILE=/dev/null PIP_NO_INDEX=1 PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DG_FORCE_BUILD=1 DG_USE_LOCAL_VERSION=0 \
    FLASH_MLA_DISABLE_SM100=1 FLASH_MLA_DISABLE_FP16=1 \
    MAX_JOBS=16 NVCC_THREADS=2 CUDA_HOME=/usr/local/cuda
# Weaver already has 125 filesystem layers. Mount build inputs and use one
# additional layer to stay below overlay2's limit.
RUN --network=none --mount=type=bind,source=.,target=/build \
    bash /build/build-weaver.sh prepare && \
    bash /build/build-weaver.sh DeepGEMM && \
    bash /build/build-weaver.sh FlashMLA

FROM scratch AS wheels
COPY --from=builder /opt/nexspec/wheels /wheels
COPY --from=builder /opt/nexspec/evidence /evidence
