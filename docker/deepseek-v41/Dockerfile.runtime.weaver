# Preserve Weaver's Torch/TE binaries; add only the verified source/wheel overlay.
ARG BASE_IMAGE=harbor.local.clusters/bp/weaver-trainer-megatron-bridge:v1.14.92@sha256:cba116d15f4be378c467a5d15157b69e3307e21c3c67342a06481f8f4a1187df
FROM ${BASE_IMAGE}
USER root
ENV PYTHONPATH=/opt/nexspec/overlay/nvidia_cutlass_dsl/dsl_packages:/opt/nexspec/overlay:/opt/nexspec/megatron-src:/opt/nexspec/tile:/opt/nexspec/src \
    PATH=/opt/nexspec/bin:${PATH} \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_INDEX=1
RUN --network=none --mount=type=bind,source=.,target=/build \
    python /build/assemble-weaver.py && \
    python /build/smoke.py && \
    specforge --help > /opt/nexspec/evidence/cli-help.txt
WORKDIR /opt/nexspec/src
ENTRYPOINT []
CMD ["/bin/bash"]
